{
    "name": "Journey: Tab Collector",
    "version": "1.0.3",
    "description": "Extension to manage and share your web journey by sharing open tab URLs.",
    "manifest_version": 3,
    "author": "Whiskay",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Journey: Tab Collector"
    },
    "host_permissions": ["*://*/*"],
    "content_scripts": [
        {
            "matches": [
                "https://*/*"
            ],
            "js": [
                "background.js" 
            ]
        }
    ],
    "permissions": [
        "tabs"
    ],
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}